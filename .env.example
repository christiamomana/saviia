# Google OAuth (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: https://<tu-dominio>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth / Auth.js
# Generate with: npx auth secret
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Turso (libSQL)
# Local dev: TURSO_DATABASE_URL=file:./prisma/dev.db (deja TURSO_AUTH_TOKEN vacío)
# Producción: TURSO_DATABASE_URL=libsql://<db>.turso.io + TURSO_AUTH_TOKEN=<token>
# Para crear las tablas en una base Turso real usa `npm run db:migrate:turso`
# (no `prisma migrate`, que no soporta el esquema libsql:// — ver README).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Correo que se siembra como administrador inicial (opcional, tiene un default)
SEED_ADMIN_EMAIL=
